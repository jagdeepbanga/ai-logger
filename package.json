{
  "name": "ai-logger",
  "version": "0.1.0",
  "description": "See and browse every request Claude Code sends to the model, in a local web UI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagdeepbanga/ai-logger.git"
  },
  "homepage": "https://github.com/jagdeepbanga/ai-logger#readme",
  "bugs": "https://github.com/jagdeepbanga/ai-logger/issues",
  "type": "module",
  "bin": {
    "ai-logger": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc -p tsconfig.server.json",
    "build:ui": "vite build",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "llm",
    "observability",
    "proxy",
    "prompt-logging"
  ],
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vitest": "^5.0.0"
  }
}
